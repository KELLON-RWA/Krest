{
  "name": "@krest/middleware-node",
  "version": "0.1.0",
  "description": "Privacy-first Node.js, Express, and Next.js API telemetry middleware for Krest",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KELLON-RWA/Krest.git",
    "directory": "packages/middleware-node"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
