# === Backend API (apps/api on VPS) ===
# Neon PostgreSQL pooled connection string (required)
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/krest?sslmode=require

# Cryptographically random secret (min 32 chars, required)
AUTH_SECRET=replace-with-random-64-char-hex-string

# Port for Fastify API server
PORT=4000
HOST=0.0.0.0

# Allowed frontend origin for authenticated dashboard CORS (e.g., https://krest.kellon.xy)
CORS_ORIGIN=http://localhost:3000

# Cookie domain for cross-subdomain auth in production (e.g., .krest.kellon.xy)
# Leave empty for localhost development
COOKIE_DOMAIN=

# Set to true when behind Caddy/Nginx/Cloudflare reverse proxy
TRUST_PROXY=false

# === Frontend Dashboard (apps/web on Vercel) ===
NEXT_PUBLIC_API_URL=http://localhost:4000
