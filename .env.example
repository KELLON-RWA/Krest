# === Backend API (apps/api on VPS) ===
# Neon PostgreSQL pooled connection string (required)
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/krest?sslmode=require

# Port for Fastify API server
PORT=4100
HOST=0.0.0.0

# Comma-separated dashboard origins allowed to make credentialed requests.
# Public ingestion (/v1/ingest/*) and /krest.js are open by design; per-project
# allowedOrigins are enforced on ingestion separately.
CORS_ORIGIN=http://localhost:3000

# Cookie domain for cross-subdomain auth in production (e.g., .kellon.xyz)
# Leave empty for localhost development
COOKIE_DOMAIN=

# Set to true when behind Caddy/Nginx/Cloudflare reverse proxy. Required for
# per-visitor hashing to see real client IPs instead of the proxy IP.
TRUST_PROXY=false

# Delete raw web/API events older than this many days. 0 keeps events forever.
EVENT_RETENTION_DAYS=90

# === Frontend Dashboard (apps/web on Vercel) ===
NEXT_PUBLIC_API_URL=http://localhost:4100
